{
  "name": "fantom-language-server",
  "displayName": "Fantom Language Server",
  "description": "Language support for Fantom with syntax highlighting, diagnostics, and autocompletion",
  "version": "0.1.0",
  "publisher": "AndreaGiusti",
  "license": "AFL-3.0",
  "icon": "icons/fantom-icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "fantom",
    "language-server",
    "autocompletion",
    "diagnostics"
  ],
  "activationEvents": [
    "onLanguage:fantom",
    "workspaceContains:build.fan",
    "workspaceContains:*/build.fan",
    "workspaceContains:**/build.fan",
    "workspaceContains:build.all",
    "workspaceContains:fan.config.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fantom",
        "aliases": [
          "Fantom",
          "fantom"
        ],
        "extensions": [
          ".fan"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/fantom-icon-transp.png",
          "dark": "./icons/fantom-icon-transp.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "fantom",
        "scopeName": "source.fantom",
        "path": "./syntaxes/fantom.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "fantom",
        "label": "Fantom Debug",
        "languages": [
          "fantom"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "mainClass": {
                "type": "string",
                "description": "Fantom main class to run, e.g. \"myPod::Main\". Leave empty when using a launcher like \"fin\" that already knows its entry point."
              },
              "fanExe": {
                "type": "string",
                "description": "Path to the fan or fin executable. Defaults to fanPath from fan.config.json (or finPath if set)."
              },
              "launcherArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments passed to the fan/fin executable before the main class, e.g. [\"-noAuth\"].",
                "default": []
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command-line arguments passed to the Fantom program.",
                "default": []
              },
              "sourceDir": {
                "type": "string",
                "description": "Root directory to search for .fan source files.",
                "default": "${workspaceFolder}"
              },
              "debugPort": {
                "type": "number",
                "description": "JDWP port the Fantom JVM will listen on.",
                "default": 5005
              },
              "noDebug": {
                "type": "boolean",
                "description": "Run without attaching the debugger.",
                "default": false
              },
              "preLaunchRebuild": {
                "type": "boolean",
                "description": "Rebuild the pod (fan build.fan) with debug=true before launching, so local variables are visible in the debugger. Requires a build.fan in sourceDir. Set to true the first time you debug, or whenever source changes.",
                "default": true
              },
              "startupTimeout": {
                "type": "number",
                "description": "Seconds to wait for the JVM JDWP agent to become ready. Default is 60. Increase this for applications that take a long time to start (e.g. 120 for large FIN stacks).",
                "default": 60
              }
            }
          },
          "attach": {
            "required": [
              "port"
            ],
            "properties": {
              "host": {
                "type": "string",
                "description": "Host where the Fantom JVM is listening for JDWP connections.",
                "default": "localhost"
              },
              "port": {
                "type": "number",
                "description": "JDWP port to attach to.",
                "default": 5005
              },
              "sourceDir": {
                "type": "string",
                "description": "Root directory to search for .fan source files.",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "fantom",
            "request": "launch",
            "name": "Launch Fantom",
            "mainClass": "myPod::Main",
            "sourceDir": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Fantom: Launch",
            "description": "Launch a Fantom program with the debugger attached.",
            "body": {
              "type": "fantom",
              "request": "launch",
              "name": "Launch Fantom",
              "mainClass": "${1:myPod::Main}",
              "sourceDir": "^\"\\${workspaceFolder}\""
            }
          },
          {
            "label": "Fantom: Attach",
            "description": "Attach to a Fantom JVM already running with JDWP enabled.",
            "body": {
              "type": "fantom",
              "request": "attach",
              "name": "Attach to Fantom",
              "port": 5005,
              "sourceDir": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "fantom.removeUnusedImports",
        "title": "Remove Unused Imports in File",
        "category": "Fantom"
      },
      {
        "command": "fantom.removeUnusedImportsInProject",
        "title": "Remove Unused Imports in Project",
        "category": "Fantom"
      },
      {
        "command": "fantom.removeUnusedVariables",
        "title": "Remove Unused Variables in File",
        "category": "Fantom"
      },
      {
        "command": "fantom.removeUnusedVariablesInProject",
        "title": "Remove Unused Variables in Project",
        "category": "Fantom"
      },
      {
        "command": "fantom.createLaunchJson",
        "title": "Create launch.json for Fantom Debugger",
        "category": "Fantom"
      },
      {
        "command": "fantom.formatProject",
        "title": "Format Entire Project",
        "category": "Fantom"
      },
      {
        "command": "fantom.rebuildDebugAdapter",
        "title": "Rebuild debugger",
        "category": "Fantom"
      },
      {
        "command": "fantom.compile",
        "title": "Compile Project",
        "category": "Fantom"
      },
      {
        "command": "fantom.runAllTests",
        "title": "Run All Tests",
        "category": "Fantom"
      },
      {
        "command": "fantom.runTestsInFile",
        "title": "Run All Tests in File…",
        "category": "Fantom"
      },
      {
        "command": "fantom.runTestMethod",
        "title": "Run Test Method…",
        "category": "Fantom"
      }
    ],
    "keybindings": [
      {
        "command": "fantom.compile",
        "key": "ctrl+f9",
        "mac": "cmd+f9"
      },
      {
        "command": "fantom.runAllTests",
        "key": "ctrl+shift+f9",
        "mac": "cmd+shift+f9"
      },
      {
        "command": "fantom.runTestsInFile",
        "key": "ctrl+f10",
        "mac": "cmd+f10"
      },
      {
        "command": "fantom.runTestMethod",
        "key": "ctrl+shift+f10",
        "mac": "cmd+shift+f10"
      }
    ],
    "configuration": {
      "title": "Fantom",
      "properties": {
        "fantom.javaPath": {
          "type": "string",
          "default": "",
          "description": "Path to java executable (defaults to $JAVA_HOME/bin/java)"
        },
        "fantom.suppressJavaWarning": {
          "type": "boolean",
          "default": false,
          "description": "Suppress the startup warning when Java is not found. Enable this if you do not use the Fantom debugger."
        },
        "fantom.suppressWarningPopup": {
          "type": "boolean",
          "default": false,
          "description": "Suppress the 'Warnings found' notification popup shown at startup when the build produces warnings."
        },
        "fantom.useBuiltInLspPod": {
          "type": "boolean",
          "default": true,
          "description": "Use the LSP pod bundled with this extension. When false, the lsp pod must already be installed in your fan environment."
        },
        "fantom.pedanticMode": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Warn on variable declarations that lack explicit type annotations (no type on left side and no 'as' cast on right side)."
        },
        "fantom.inlayHints.enable": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show inline hints for inferred variable types and method-call parameter names."
        },
        "fantom.inlayHints.skipSingleParamCalls": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Skip the parameter-name hint for calls that take only one argument."
        },
        "fantom.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between VSCode and the language server"
        },
        "fantom.format.enable": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable the Fantom source formatter (Format Document / Format Selection)."
        },
        "fantom.format.formatOnSave": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Automatically format Fantom files when saved. When enabled, the extension applies the formatter before each save without requiring editor.formatOnSave to be set globally."
        },
        "fantom.format.indentSize": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "scope": "resource",
          "description": "Number of spaces per indentation level (used when fantom.format.useTabs is false)."
        },
        "fantom.format.useTabs": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Use tab characters for indentation instead of spaces."
        },
        "fantom.format.insertFinalNewline": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Ensure the file ends with a newline."
        },
        "fantom.format.trimTrailingWhitespace": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Remove trailing whitespace from each line."
        },
        "fantom.format.maxBlankLines": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "scope": "resource",
          "description": "Maximum number of consecutive blank lines to preserve. Set to 0 to keep all blank lines."
        },
        "fantom.format.respectEditorConfig": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Override formatter settings with values from .editorconfig files."
        },
        "fantom.format.collapseSpaces": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Collapse runs of two or more consecutive spaces into a single space in code regions (outside string literals and comments). For example: 'val ?        0 : 1' becomes 'val ? 0 : 1'."
        },
        "fantom.format.maxLineLength": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "resource",
          "description": "Wrap lines that exceed this length. Splits at commas inside parentheses, '&&', '||', or ternary '?'. Set to 0 to disable wrapping."
        }
      }
    }
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "vscode:prepublish": "cp ../README.md README.md && pnpm run compile && pnpm run bundle-lsp && pnpm run bundle-debug-adapter && pnpm run bundle-extension -- --production",
    "compile": "tsc -p ./",
    "bundle-lsp": "node scripts/bundle-lsp.js",
    "bundle-extension": "node scripts/bundle-extension.js",
    "bundle-debug-adapter": "node scripts/bundle-debug-adapter.js",
    "build-debug-adapter": "bash debug-adapter/build.sh",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile",
    "lint": "eslint src --ext ts",
    "test:extension": "node out/test/declarationRange.test.js && node out/test/shadowDir.test.js",
    "test:integration": "node out/test/debugAdapter.test.js",
    "test:integration:vscode": "node out/test/integration/runTest.js",
    "test:grammar": "vscode-tmgrammar-snap -g syntaxes/fantom.tmLanguage.json -s source.fantom \"test/grammar/*.fan\"",
    "test:grammar:update": "vscode-tmgrammar-snap -u -g syntaxes/fantom.tmLanguage.json -s source.fantom \"test/grammar/*.fan\"",
    "test:lint": "node out/test/lint.test.js",
    "publish:prerelease": "vsce publish --pre-release",
    "publish:stable": "vsce publish"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.0",
    "eslint": "^8.x",
    "mocha": "^10.7.3",
    "typescript": "^5.3.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fantom-lang/fantom"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "serialize-javascript": ">=7.0.3",
      "eslint>minimatch": "^3.1.4",
      "glob>minimatch": "^3.1.4",
      "vscode-languageclient>minimatch": "^5.1.8",
      "@typescript-eslint/typescript-estree>minimatch": "^9.0.7",
      "flat-cache>flatted": "^3.4.2",
      "picomatch": "^2.3.2",
      "ajv": "^6.14.0",
      "brace-expansion@>=2.0.0 <2.1.2": ">=2.1.2",
      "brace-expansion@<=5.0.7": ">=5.0.8"
    }
  }
}
