{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fantom",
  "scopeName": "source.fantom",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.fantom",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.fantom" }
          }
        },
        {
          "name": "comment.block.fantom",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.fantom" }
          }
        },
        {
          "comment": "Fantom line doc comment: ** at start of line (with optional leading whitespace)",
          "name": "comment.line.documentation.fantom",
          "match": "^\\s*\\*\\*.*$"
        },
        {
          "name": "comment.line.double-slash.fantom",
          "begin": "//",
          "end": "$",
          "captures": {
            "0": { "name": "punctuation.definition.comment.fantom" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fantom",
          "match": "\\b(if|else|while|for|foreach|return|break|continue|switch|case|default|try|catch|finally|throw|assert)\\b"
        },
        {
          "name": "keyword.other.fantom",
          "match": "\\b(class|mixin|enum|facet|using|abstract|const|final|native|new|override|private|protected|public|internal|static|virtual|volatile|readonly|once|this|super|it)\\b"
        },
        {
          "name": "constant.language.fantom",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "storage.type.fantom",
          "match": "\\b(Void|Bool|Int|Float|Decimal|Duration|Str|Uri|Type|Slot|Field|Method|Pod|List|Map|Range|Buf|Obj)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.fantom",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.fantom",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.fantom",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.fantom" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.fantom" }
              },
              "patterns": [{ "include": "#interpolation-body" }]
            },
            {
              "name": "variable.other.fantom",
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_.]*"
            }
          ]
        },
        {
          "comment": "URI literal using backticks",
          "name": "string.interpolated.uri.fantom",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.fantom",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.fantom",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.fantom",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.fantom",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.fantom" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.fantom" }
              },
              "patterns": [{ "include": "#interpolation-body" }]
            },
            {
              "name": "variable.other.fantom",
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_.]*"
            }
          ]
        },
        {
          "comment": "Character literal: single char between single quotes, e.g. 'a', '\\n', '\\u0041'",
          "name": "constant.character.fantom",
          "match": "'(\\\\u[0-9a-fA-F]{4}|\\\\.|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.fantom",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.float.fantom",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?[fFdD]?\\b"
        },
        {
          "name": "constant.numeric.integer.fantom",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.fantom",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.fantom",
          "match": "\\b[a-z][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.fantom",
          "match": "(:=|<=>|\\?:|\\?\\.|\\.\\.|\\.\\.\\<|\\+\\+|--|\\+|-|\\*|/|%|===|!==|==|!=|<=|>=|<|>|&&|\\|\\||!|&|\\||\\^|~|<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|=|->)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.parens.begin.fantom",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.fantom",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.fantom",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.fantom",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.braces.begin.fantom",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.fantom",
          "match": "\\}"
        }
      ]
    },
    "interpolation-body": {
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "#interpolation-body" }]
        },
        { "include": "$self" }
      ]
    }
  }
}
